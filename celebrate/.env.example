# CELEBRATE Frontend Environment Variables Example
# Copy this file to .env.local for local development
# DO NOT commit .env.local or any .env files to the repository

# Gemini API Key for AI Assistant (Optional)
# If not provided, the application uses the built-in algorithmic planning engine
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI Key for Venue/Vendor Discovery (Optional)
# If not provided, search functionality shows a helpful message without live results
SERPAPI_API_KEY=your_serpapi_key_here

# Backend API URL (Optional - defaults to Render deployment)
VITE_BACKEND_URL=https://celebrate-event-planner.onrender.com

# Node Environment
NODE_ENV=development
